# Keep secrets in your hosting provider's environment settings, never in Git.
BOT_TOKEN=
DELIVERY=polling
# Your numeric Telegram user ID. The bot refuses to start without it.
OWNER_ID=
# Public HTTPS address of the deployed web service (without trailing slash).
PUBLIC_URL=
# Random 32+ character value; used to authenticate Telegram webhooks.
WEBHOOK_SECRET=
PORT=10000
# cloud = official API, incoming files limited to 20 MB.
BOT_API_URL=https://api.telegram.org
# Optional local Bot API server on a private network with a shared media folder.
LOCAL_FILES_ROOT=
MAX_INPUT_MB=20
MAX_OUTPUT_PIXELS=8000000
MAX_JOB_SECONDS=660
VIDEO_SIZE=640
VIDEO_CRF=18
FFMPEG_THREADS=1
MODEL_PATH=/app/models/realesr-general-x4v3.onnx
WORK_DIR=/tmp/circle-bot
